    GROUP BY p.POLICY_ID, p.POLICY_NUMBER, p.STATUS
),

policies_without_premiums AS (
    SELECT
        POLICY_ID,
        POLICY_NUMBER,
        STATUS,
        PREMIUM_TRANSACTION_COUNT
    FROM premium_transaction_count
    WHERE PREMIUM_TRANSACTION_COUNT = 0
)

