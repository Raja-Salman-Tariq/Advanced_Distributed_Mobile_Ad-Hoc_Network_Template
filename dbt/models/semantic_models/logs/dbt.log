        state_code,
        zip_code,
        email,
        phone,

        -- Date Attributes
        appointment_date,
        created_date

    from int_agency
    where agency_id IS NOT NULL
      and agency_code IS NOT NULL
      and agency_name IS NOT NULL
      and license_number IS NOT NULL
)

select * from final
    )
;
