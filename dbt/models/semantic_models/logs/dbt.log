    FROM EKAI.demoModel_18_marts.fct_policy_premiums
    SAMPLE BERNOULLI (50000 ROWS)
    WHERE WRITTEN_PREMIUM < 0

    UNION ALL

    SELECT
        'fct_policy_premiums' AS source_table,
        PREMIUM_ID AS record_id,
