   as (
    

with source as (
    select * from SENTINEL_INSURANCE.BRONZE.AGENCY
),

renamed as (
    select
        -- Primary Keys
        AGENCY_ID::NUMBER as agency_id,
        AGENCY_CODE::VARCHAR as agency_code,

        -- Agency Attributes
